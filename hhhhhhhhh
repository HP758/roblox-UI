            local popList = Instance.new("UIListLayout")
            popList.Parent = pop

            for _, v in ipairs(list) do
                local opt = Instance.new("TextButton")
                opt.Size = UDim2.new(1, 0, 0, 26)
                opt.BackgroundColor3 = CurrentTheme.Panel
                opt.BackgroundTransparency = 1
                opt.Text = v
