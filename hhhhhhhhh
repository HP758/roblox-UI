function DynamicUI:Notify(text, kind, duration)
    if not NotifyHolder then return end
    kind = kind or "info"
    duration = duration or 2.5

    local colors = {
        success = Color3.fromRGB(80, 200, 130),
        warn    = Color3.fromRGB(240, 180, 80),
        error   = Color3.fromRGB(240, 90, 100),
        info    = Color3.fromRGB(120, 150, 255),
        rainbow = Color3.fromRGB(255, 255, 255),
    }

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 0)
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.BackgroundColor3 = CurrentTheme.Card
    frame.BackgroundTransparency = 0.05
    frame.Position = UDim2.new(1, 20, 0, 0)
    frame.Parent = NotifyHolder
    corner(frame, 12)

    if kind == "rainbow" then
        rainbowStroke(frame, 1.5, 0.1)
    else
        stroke(frame, CurrentTheme.Border, 0.55, 1)
    end

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -16)
    bar.Position = UDim2.new(0, 8, 0, 8)
    bar.BackgroundColor3 = colors[kind] or colors.info
    bar.BorderSizePixel = 0
    bar.Parent = frame
    corner(bar, 2)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -24, 0, 0)
    lbl.Position = UDim2.new(0, 18, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
