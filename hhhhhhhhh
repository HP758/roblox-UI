-- ============== 工具函数（带 pcall 保护，避免 v3.2 那种崩溃） ==============
local function tw(obj, t, props, style, dir)
    if not obj then return end
    local ok, tween = pcall(function()
        return TweenService:Create(
            obj,
            TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
            props
        )
    end)
    if ok and tween then
        pcall(function() tween:Play() end)
        return tween
    end
end

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 12)
    c.Parent = p
    return c
end

local function stroke(p, color, trans, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Transparency = trans or 0
    s.Thickness = thick or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    return s
end

local function padding(p, all)
    local ui = Instance.new("UIPadding")
    ui.PaddingTop    = UDim.new(0, all)
    ui.PaddingBottom = UDim.new(0, all)
    ui.PaddingLeft   = UDim.new(0, all)
    ui.PaddingRight  = UDim.new(0, all)
    ui.Parent = p
    return ui
end

-- 彩虹渐变（流光边框核心）
local RAINBOW_SEQ = ColorSequence.new({
    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 80, 120)),
    ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 180, 80)),
    ColorSequenceKeypoint.new(0.40, Color3.fromRGB(255, 240, 90)),
    ColorSequenceKeypoint.new(0.60, Color3.fromRGB(90, 255, 160)),
    ColorSequenceKeypoint.new(0.80, Color3.fromRGB(90, 180, 255)),
    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(200, 120, 255)),
})

local RainbowGradients = {}
local function rainbowStroke(parent, thick, trans)
    local s = Instance.new("UIStroke")
    s.Thickness = thick or 1.5
    s.Transparency = trans or 0.15
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = Color3.new(1, 1, 1)
    s.Parent = parent

    local g = Instance.new("UIGradient")
    g.Color = RAINBOW_SEQ
    g.Rotation = 0
    g.Parent = s

    table.insert(RainbowGradients, g)
    return s
end

-- 全局彩虹旋转（低频，不卡）
task.spawn(function()
    while true do
        pcall(function()
            for i = #RainbowGradients, 1, -1 do
                local g = RainbowGradients[i]
                local ok, parent = pcall(function() return g.Parent end)
                if ok and parent then
                    g.Rotation = (g.Rotation + 3) % 360
                else
                    table.remove(RainbowGradients, i)
                end
            end
        end)
        task.wait(0.05)
    end
end)

-- 防止 UI 拖出屏幕
local function clampPosition(frame, gui)
    if not frame or not frame.Parent then return end
    local ok = pcall(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local viewport = cam.ViewportSize
        local size = frame.AbsoluteSize
        local anchor = frame.AnchorPoint
        local px = frame.Position.X.Offset
        local py = frame.Position.Y.Offset

        local left   = px - size.X * anchor.X
        local top    = py - size.Y * anchor.Y
        local right  = left + size.X
        local bottom = top + size.Y

        if left < 8 then px = px + (8 - left) end
        if top < 8 then py = py + (8 - top) end
        if right > viewport.X - 8 then px = px - (right - (viewport.X - 8)) end
        if bottom > viewport.Y - 8 then py = py - (bottom - (viewport.Y - 8)) end

        frame.Position = UDim2.new(0, px, 0, py)
    end)
end

