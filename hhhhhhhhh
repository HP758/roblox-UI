				local p1, p2 = picker.AbsolutePosition, picker.AbsolutePosition + picker.AbsoluteSize
				local k1, k2 = swatch.AbsolutePosition, swatch.AbsolutePosition + swatch.AbsoluteSize
				if not (ax >= p1.X and ax <= p2.X and ay >= p1.Y and ay <= p2.Y)
				and not (ax >= k1.X and ax <= k2.X and ay >= k1.Y and ay <= k2.Y) then
					pickerOpen = false; picker.Visible = false
