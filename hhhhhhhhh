-- ============ 创建 ScreenGui (三层兜底) ============
local function ensureGui()
    -- 清理旧的
    local function cleanup(p)
        if not p then return end
        local old = p:FindFirstChild("DynamicUI_Root")
        if old then old:Destroy() end
    end

    local g = Instance.new("ScreenGui")
    g.Name = "DynamicUI_Root"
    g.IgnoreGuiInset = true
    g.ResetOnSpawn = false
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    g.DisplayOrder = 999

    -- 优先 gethui
    local target
    local ok1, hui = pcall(function() return gethui and gethui() end)
    if ok1 and hui then
        cleanup(hui)
        target = hui
    else
        -- 尝试 CoreGui
        local ok2 = pcall(function()
            cleanup(CoreGui)
            g.Parent = CoreGui
        end)
        if not ok2 then
            -- 最后 PlayerGui
            local pg = LP:WaitForChild("PlayerGui")
            cleanup(pg)
            g.Parent = pg
            return g
        else
            return g
        end
    end
    g.Parent = target

    -- syn 保护
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(g) end end)
    pcall(function() if protectgui then protectgui(g) end end)
    return g
end

