-- ============ 工具函数 ============
local function tw(obj, t, props)
    if not obj then return end
    local ok, tween = pcall(function()
        return TweenService:Create(obj, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    end)
    if ok and tween then pcall(function() tween:Play() end) end
end

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = p
end

local function stroke(p, color, trans, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Transparency = trans or 0
    s.Thickness = thick or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    return s
end

-- 彩虹渐变
local RAINBOW = ColorSequence.new({
    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 80, 120)),
    ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 80)),
    ColorSequenceKeypoint.new(0.50, Color3.fromRGB(100, 255, 160)),
    ColorSequenceKeypoint.new(0.75, Color3.fromRGB(100, 180, 255)),
    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(200, 120, 255)),
})

local rainbowList = {}
local function rainbowStroke(parent, thick, trans)
    local s = Instance.new("UIStroke")
    s.Thickness = thick or 1.5
    s.Transparency = trans or 0.1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = Color3.new(1, 1, 1)
    s.Parent = parent

    local g = Instance.new("UIGradient")
    g.Color = RAINBOW
    g.Rotation = 0
    g.Parent = s
    table.insert(rainbowList, g)
    return s
end

-- 全局旋转协程: 简单单循环, 不抛错
task.spawn(function()
    while true do
        task.wait(0.05)
        for i = #rainbowList, 1, -1 do
            local g = rainbowList[i]
            if typeof(g) == "Instance" and g.Parent then
                g.Rotation = (g.Rotation + 3) % 360
            else
                table.remove(rainbowList, i)
            end
        end
    end
end)

-- 屏幕 clamp
local function clampPosition(frame)
    if not frame or not frame.Parent then return end
    pcall(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local size = frame.AbsoluteSize
        local anchor = frame.AnchorPoint
        local px = frame.Position.X.Offset
        local py = frame.Position.Y.Offset
        local left = px - size.X * anchor.X
        local top  = py - size.Y * anchor.Y
        local right = left + size.X
        local bottom = top + size.Y
        if left < 8 then px = px + (8 - left) end
        if top < 8 then py = py + (8 - top) end
        if right > vp.X - 8 then px = px - (right - (vp.X - 8)) end
        if bottom > vp.Y - 8 then py = py - (bottom - (vp.Y - 8)) end
        frame.Position = UDim2.new(0, px, 0, py)
    end)
end

