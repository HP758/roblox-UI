                opt.MouseLeave:Connect(function() tw(opt, 0.1, {BackgroundTransparency = 1}) end)
                opt.MouseButton1Click:Connect(function()
                    selected = v
                    btn.Text = v .. "  ▾"
                    pop.Visible = false
                    opened = false
                    DynamicUI:Notify("已选: " .. v, "info", 1.2)
                    if callback then pcall(callback, v) end
                end)
                subscribe(function(t) opt.TextColor3 = t.Text end)
            end

            local function positionPop()
                local p = btn.AbsolutePosition
                local s = btn.AbsoluteSize
                local viewport = workspace.CurrentCamera.ViewportSize
                local popH = #list * 26
                local belowSpace = viewport.Y - (p.Y + s.Y) - 8
                if belowSpace < popH and p.Y > popH then
                    pop.Position = UDim2.new(0, p.X, 0, p.Y - popH - 4)
                else
                    pop.Position = UDim2.new(0, p.X, 0, p.Y + s.Y + 4)
                end
            end

            btn.MouseButton1Click:Connect(function()
                opened = not opened
                if opened then
                    positionPop()
                    pop.Visible = true
                    pop.Size = UDim2.new(0, 140, 0, 0)
                    tw(pop, 0.18, {Size = UDim2.new(0, 140, 0, #list * 26)}, Enum.EasingStyle.Quad)
                else
                    tw(pop, 0.15, {Size = UDim2.new(0, 140, 0, 0)})
                    task.delay(0.18, function() pop.Visible = false end)
                end
            end)

            UserInputService.InputBegan:Connect(function(i)
                if opened and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                    local mp = UserInputService:GetMouseLocation()
                    local pp = pop.AbsolutePosition
                    local ps = pop.AbsoluteSize
                    local bp = btn.AbsolutePosition
                    local bs = btn.AbsoluteSize
                    local inPop = mp.X >= pp.X and mp.X <= pp.X + ps.X and mp.Y >= pp.Y and mp.Y <= pp.Y + ps.Y
                    local inBtn = mp.X >= bp.X and mp.X <= bp.X + bs.X and mp.Y >= bp.Y and mp.Y <= bp.Y + bs.Y
                    if not inPop and not inBtn then
                        opened = false
                        tw(pop, 0.15, {Size = UDim2.new(0, 140, 0, 0)})
                        task.delay(0.18, function() pop.Visible = false end)
                    end
                end
            end)

            return {
                Set = function(_, v) selected = v; btn.Text = v .. "  ▾"; if callback then pcall(callback, v) end end,
                Get = function() return selected end,
            }
        end

