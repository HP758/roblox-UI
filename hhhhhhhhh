    function Window:Notify(text, kind, dur) DynamicUI:Notify(text, kind, dur) end

    function Window:SetTheme(name)
        if THEMES[name] then
            T = THEMES[name]
            pushTheme()
            DynamicUI:Notify("主题已切换: " .. name, "info", 1.5)
        end
    end

    local rainbowOn = false
    function Window:SetRainbow(on)
        rainbowOn = on
        if on then
            DynamicUI:Notify("彩虹模式 已开启", "rainbow", 1.5)
            task.spawn(function()
                local h = 0
                while rainbowOn do
                    h = (h + 0.005) % 1
                    T.Accent = Color3.fromHSV(h, 0.6, 1)
                    pushTheme()
                    task.wait(0.06)
                end
            end)
        else
            DynamicUI:Notify("彩虹模式 已关闭", "info", 1.5)
        end
    end

    function Window:Bind(key)
        UserInputService.InputBegan:Connect(function(i, gp)
            if not gp and i.KeyCode == key then
                Window:_setMin(not Window._minimized)
            end
        end)
    end

    function Window:Destroy()
        if gui and gui.Parent then gui:Destroy() end
    end

    -- ★ 关键: 入场动画在窗口已可见的前提下播放
    win.Size = UDim2.new(0, 0, 0, 0)
    tw(win, 0.35, {Size = UDim2.new(0, 620, 0, 400)})

    task.delay(0.4, function()
        DynamicUI:Notify("加载成功", "success", 2)
    end)

    return Window
end

return DynamicUI
