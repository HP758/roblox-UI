function DynamicUI:Notify(text, kind, duration)
	kind = kind or "info"
	duration = duration or 2.4
	local gui = ensureGui()
	local holder = ensureNotifyHolder(gui)

	local colors = {
		success = Color3.fromRGB(80,220,140),
		warn    = Color3.fromRGB(245,180,70),
		error   = Color3.fromRGB(240,90,90),
		info    = Color3.fromRGB(140,100,255),
	}
	local accent = colors[kind] or colors.info

	local card = Instance.new("TextButton")
	card.AutoButtonColor = false
	card.Text = ""
	card.Size = UDim2.fromOffset(260, 50)
	card.BackgroundColor3 = Color3.fromRGB(20,20,28)
	card.BackgroundTransparency = 1
	card.BorderSizePixel = 0
	card.ZIndex = 1001
	card.Parent = holder
	corner(card, UDim.new(0, 10))

	if kind == "rainbow" then
		rainbowBorder(card, 1.5, 0)
	else
		stroke(card, accent, 0.3, 1.2)
	end

	local strip = Instance.new("Frame")
	strip.Size = UDim2.new(0, 3, 1, -16)
	strip.Position = UDim2.new(0, 10, 0, 8)
	strip.BackgroundColor3 = accent
	strip.BorderSizePixel = 0
	strip.ZIndex = 1002
	strip.Parent = card
	corner(strip, UDim.new(1,0))

	local msg = Instance.new("TextLabel")
	msg.BackgroundTransparency = 1
	msg.Position = UDim2.new(0, 22, 0, 0)
	msg.Size = UDim2.new(1, -32, 1, 0)
	msg.Font = Enum.Font.GothamMedium
	msg.TextSize = 12
	msg.TextXAlignment = Enum.TextXAlignment.Left
	msg.TextColor3 = Color3.fromRGB(240,240,248)
	msg.TextTransparency = 1
	msg.Text = text
	msg.TextWrapped = true
	msg.ZIndex = 1003
	msg.Parent = card

	tw(card, EASE_SPRING, {BackgroundTransparency = 0.05})
	tw(msg, EASE_OUT, {TextTransparency = 0})

	task.delay(duration, function()
		tw(card, EASE_OUT, {BackgroundTransparency = 1})
		tw(msg, EASE_OUT, {TextTransparency = 1})
		task.wait(0.4)
		if card.Parent then card:Destroy() end
	end)
end

------------------------------------------------------------------
-- 拖动
------------------------------------------------------------------
local function makeDraggable(target, gui)
	local dragging = false
	local startInputPos, startTargetPos
	target.Active = true
	target.InputBegan:Connect(function(i)
		if dragging then return end
		if i.UserInputType ~= Enum.UserInputType.MouseButton1
		and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local objs = PlayerGui:GetGuiObjectsAtPosition(i.Position.X, i.Position.Y)
		for _, o in ipairs(objs) do
			if o ~= target and (o:IsA("TextButton") or o:IsA("ImageButton") or o:IsA("TextBox")) then
				return
			end
			if o == target then break end
		end
		dragging = true
		startInputPos = i.Position
		startTargetPos = target.Position
	end)
	UserInputService.InputChanged:Connect(function(i)
		if not dragging then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch then
			local d = i.Position - startInputPos
			target.Position = UDim2.new(
				startTargetPos.X.Scale, startTargetPos.X.Offset + d.X,
				startTargetPos.Y.Scale, startTargetPos.Y.Offset + d.Y
			)
			clampPos(target, gui.AbsoluteSize)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			clampPos(target, gui.AbsoluteSize)
		end
	end)
end

local globalClicks = {}
UserInputService.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1
	or i.UserInputType == Enum.UserInputType.Touch then
		for _, fn in ipairs(globalClicks) do pcall(fn, i) end
	end
end)

