                open = not open
                if open then
                    local ap = b.AbsolutePosition
                    local as = b.AbsoluteSize
                    local vp = workspace.CurrentCamera.ViewportSize
                    local h = #list * 26
                    if vp.Y - (ap.Y + as.Y) < h + 20 and ap.Y > h then
                        pop.Position = UDim2.new(0, ap.X, 0, ap.Y - h - 4)
