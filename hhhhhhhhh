            title.TextSize = 13
            title.TextColor3 = CurrentTheme.Accent
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.Parent = row
            subscribe(function(t) title.TextColor3 = t.Accent end)

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(1, -20, 1, -88)
            box.Position = UDim2.new(0, 10, 0, 36)
            box.BackgroundColor3 = CurrentTheme.Bg
            box.PlaceholderText = "-- 在这里粘贴 Lua 代码..."
            box.PlaceholderColor3 = CurrentTheme.Sub
            box.Text = ""
            box.Font = Enum.Font.Code
            box.TextSize = 12
            box.TextColor3 = CurrentTheme.Text
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.TextYAlignment = Enum.TextYAlignment.Top
            box.MultiLine = true
            box.ClearTextOnFocus = false
            box.TextWrapped = true
            box.Parent = row
            corner(box, 6)
            stroke(box, CurrentTheme.Border, 0.5, 1)
            subscribe(function(t)
                tw(box, 0.2, {BackgroundColor3 = t.Bg})
                box.TextColor3 = t.Text
                box.PlaceholderColor3 = t.Sub
            end)

            local urlBox = Instance.new("TextBox")
            urlBox.Size = UDim2.new(1, -240, 0, 32)
            urlBox.Position = UDim2.new(0, 10, 1, -42)
            urlBox.BackgroundColor3 = CurrentTheme.Hover
            urlBox.PlaceholderText = "https://链接.lua"
            urlBox.PlaceholderColor3 = CurrentTheme.Sub
            urlBox.Text = ""
            urlBox.Font = Enum.Font.Gotham
            urlBox.TextSize = 12
            urlBox.TextColor3 = CurrentTheme.Text
            urlBox.ClearTextOnFocus = false
            urlBox.Parent = row
            corner(urlBox, 6)
            subscribe(function(t)
                tw(urlBox, 0.2, {BackgroundColor3 = t.Hover})
                urlBox.TextColor3 = t.Text
                urlBox.PlaceholderColor3 = t.Sub
            end)

            local function makeBtn(txt, off, color, fn)
                local b = Instance.new("TextButton")
                b.Size = UDim2.new(0, 70, 0, 32)
                b.Position = UDim2.new(1, off, 1, -42)
                b.BackgroundColor3 = color
                b.Text = txt
                b.Font = Enum.Font.GothamBold
                b.TextSize = 12
                b.TextColor3 = Color3.new(1, 1, 1)
                b.AutoButtonColor = false
                b.Parent = row
                corner(b, 6)
                b.MouseEnter:Connect(function() tw(b, 0.1, {BackgroundTransparency = 0.1}) end)
                b.MouseLeave:Connect(function() tw(b, 0.1, {BackgroundTransparency = 0}) end)
                b.MouseButton1Click:Connect(fn)
                return b
            end

            makeBtn("执行", -222, Color3.fromRGB(80, 200, 130), function()
                if box.Text == "" then
                    DynamicUI:Notify("代码为空", "warn")
                    return
                end
                if loadstring then
                    local ok, err = pcall(function()
                        local f, e = loadstring(box.Text)
                        if not f then error(e) end
                        f()
                    end)
                    if ok then
                        DynamicUI:Notify("已执行", "success")
                    else
                        DynamicUI:Notify("执行失败: " .. tostring(err), "error", 4)
                    end
                else
                    DynamicUI:Notify("执行器不支持 loadstring", "error")
                end
            end)
            makeBtn("清空", -148, Color3.fromRGB(240, 180, 80), function()
                box.Text = ""
                DynamicUI:Notify("已清空", "info", 1)
            end)
            makeBtn("加载", -74, Color3.fromRGB(120, 150, 255), function()
                if urlBox.Text == "" then
                    DynamicUI:Notify("链接为空", "warn")
                    return
                end
                if game and game.HttpGet then
                    local ok, src = pcall(function() return game:HttpGet(urlBox.Text) end)
                    if ok and src then
                        box.Text = src
                        DynamicUI:Notify("已加载链接", "success")
                    else
                        DynamicUI:Notify("加载失败", "error")
                    end
                end
            end)
            return row
        end

        table.insert(Window.Tabs, tab)
        if #Window.Tabs == 1 then
            switchTab(tab)
        end
        return tab
    end

    function Window:Notify(text, kind, dur) DynamicUI:Notify(text, kind, dur) end

    function Window:SetTheme(name)
        if THEMES[name] then
            CurrentTheme = THEMES[name]
            notifyTheme()
            DynamicUI:Notify("主题已切换: " .. name, "info", 1.5)
        end
    end

    function Window:SetAccent(color)
        CurrentTheme.Accent = color
        notifyTheme()
    end

    local rainbowAccent = false
    function Window:SetRainbow(on)
        rainbowAccent = on
        if on then
            DynamicUI:Notify("彩虹模式 已开启", "rainbow", 1.5)
            task.spawn(function()
                local h = 0
                while rainbowAccent do
                    h = (h + 0.005) % 1
                    CurrentTheme.Accent = Color3.fromHSV(h, 0.6, 1)
                    notifyTheme()
                    task.wait(0.05)
                end
            end)
        else
            DynamicUI:Notify("彩虹模式 已关闭", "info", 1.5)
        end
    end

    function Window:Bind(key)
        UserInputService.InputBegan:Connect(function(i, gp)
            if not gp and i.KeyCode == key then
                if minimized then
                    setMin(false)
                else
                    setMin(true)
                end
            end
        end)
    end

    function Window:Destroy()
        gui:Destroy()
    end

    -- 加载动画
    showLoader(gui, function()
        win.Visible = true
        win.Size = UDim2.new(0, 0, 0, 0)
        tw(win, 0.35, {Size = UDim2.new(0, 620, 0, 400)}, Enum.EasingStyle.Back)
        DynamicUI:Notify("加载成功", "success", 2)
    end)

    return Window
end

return DynamicUI
