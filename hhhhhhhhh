                    end
                    pop.Visible = true
                    pop.Size = UDim2.new(0, 140, 0, 0)
                    tw(pop, 0.18, {Size = UDim2.new(0, 140, 0, h)})
                else
                    tw(pop, 0.15, {Size = UDim2.new(0, 140, 0, 0)})
                    task.delay(0.16, function() pop.Visible = false end)
                end
            end)
            return {Set=function(_,v) selected=v; b.Text=v.."  ▾"; if cb then pcall(cb,v) end end, Get=function() return selected end}
